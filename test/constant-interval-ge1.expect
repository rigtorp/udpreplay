#!/usr/bin/expect -f

# Deadline was not incremented correctly for intervals greater than 1000ms

lassign $argv executable capture timer
spawn $timer -p $executable -i lo -c 1001 $capture
set result [wait]
if {[lindex $result 2] != 0 || [lindex $result 3] != 0} {
    exit 1
}
expect {
    default { exit 1 }  
    "real 3.0" { exit 0 }
}
